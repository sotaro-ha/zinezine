# =============================================================================
# npm サプライチェーン攻撃対策（2025-2026 の Shai-Hulud / Mini Shai-Hulud 等を想定）
# このファイルは必ずコミットし、全開発者・CI で同じ防御を効かせること。
# 詳細と背景は README.md「セキュリティ（npm サプライチェーン対策）」を参照。
# =============================================================================

# postinstall/preinstall 等のライフサイクルスクリプトを実行しない。
# Shai-Hulud をはじめ近年の npm ワームは postinstall を悪用して自己増殖・
# トークン窃取を行うため、これを止めるのが最重要。
# ※ ネイティブビルドが必要な依存を入れる場合のみ、信頼を確認した上で
#    `npm rebuild <pkg>` を明示的に実行する（README参照）。
ignore-scripts=true

# 公開から N 日未満の新しいバージョンはインストールしない（クールダウン）。
# 悪性版はレジストリから削除されるまでの数時間〜数日だけ存在することが多く、
# 7 日の待機で「公開直後に毒入りバージョンを掴む」事故をほぼ防げる。
# 要 npm v11.10.0 以降。
min-release-age=7

# `npm install <pkg>` で依存を追加したとき、^ や ~ ではなく完全固定で記録する。
# lockfile と合わせ、意図しない自動アップグレードを防ぐ。
save-exact=true

# インストール時に既知の脆弱性を自動監査する。
audit=true

# インストールログのノイズ（資金募集メッセージ）を抑制。
fund=false
