# 旅写真マップ — 環境変数サンプル
# このファイルをコピーして .env.local を作る。.env.local は絶対にコミットしない。
#
# NEXT_PUBLIC_ 接頭辞の変数はブラウザに露出する。anon key / MapTiler key は公開前提のキー。
# サービスロールキー等の秘匿キーには絶対に NEXT_PUBLIC_ を付けないこと。

# --- Supabase（クライアントから anon でアクセス。RLS で anon を許可） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- MapTiler（地図タイル） ---
NEXT_PUBLIC_MAPTILER_KEY=

# --- 管理者許可リスト（サーバー専用・NEXT_PUBLIC を付けない） ---
# Google ログインを許可する管理者メールを , または空白区切りで列挙。
# 未設定だと fail-closed で誰もログインできない（必ず設定すること）。
ADMIN_EMAILS=
